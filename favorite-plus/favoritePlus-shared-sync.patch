+
+        if (uid in R) {
+          out[uid] = this.list([], local[uid], out[uid]);
+          return;
+        }
+
+        const name = L[uid];
+        if (name in out.plusTypes) {
+          // a list with the same name was created on another device: join them
+          const ruid = out.plusTypes[name];
+          out[ruid] = this.list([], local[uid], out[ruid]);
+          return;
+        }
