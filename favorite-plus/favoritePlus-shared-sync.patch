+        out.plusTypes[name] = uid;
+        out[uid] = (local[uid] || []).slice();
+      });
+
+      // card objects: this device's order first, then the ones only the server has
+      const seen = new Set();
+      const cards = [];
+      local.plusTypes.card.concat(out.plusTypes.card).forEach((card) => {
+        if (!card || card.id === undefined || seen.has(String(card.id))) return;
+        seen.add(String(card.id));
+        cards.push(card);
+      });
