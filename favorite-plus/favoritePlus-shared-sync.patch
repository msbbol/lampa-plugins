+  const plusMerge = {
+    clone(obj) {
+      return JSON.parse(JSON.stringify(obj || {}));
+    },
+
+    normalize(fav) {
+      const out = this.clone(fav);
+      out.plusTypes = out.plusTypes || {};
+      out.plusTypes.card = out.plusTypes.card || [];
+      return out;
+    },
+
+    // uid -> name for user lists ('card' holds the card objects)
+    types(fav) {
+      const map = {};
+      Object.keys(fav.plusTypes || {}).forEach((name) => {
+        if (name !== 'card') map[fav.plusTypes[name]] = name;
+      });
+      return map;
+    },
+
+    list(base, local, remote) {
+      const inBase = new Set((base || []).map(String));
+      const inLocal = new Set((local || []).map(String));
+      const removed = new Set((base || []).filter((id) => !inLocal.has(String(id))).map(String));
+      const result = (remote || []).filter((id) => !removed.has(String(id)));
+      const inResult = new Set(result.map(String));
+      const added = (local || []).filter((id) => !inBase.has(String(id)) && !inResult.has(String(id)));
+      return added.concat(result);
+    },
+
+    merge(base, local, remote) {
+      base = this.normalize(base);
+      local = this.normalize(local);
+      const out = this.normalize(remote);
+
+      const B = this.types(base);
+      const L = this.types(local);
+      const R = this.types(out);
+
+      Object.keys(B).forEach((uid) => {
+        if (!(uid in L)) {
+          // deleted on this device
+          if (uid in R) {
+            delete out.plusTypes[R[uid]];
+            delete out[uid];
+            delete R[uid];
+          }
+          return;
+        }
+
+        if (!(uid in R)) return; // deleted on another device: stays deleted
+
+        if (L[uid] !== B[uid] && !(L[uid] in out.plusTypes)) {
+          // renamed on this device
+          delete out.plusTypes[R[uid]];
+          out.plusTypes[L[uid]] = uid;
+          R[uid] = L[uid];
+        }
+
+        out[uid] = this.list(base[uid], local[uid], out[uid]);
+      });
+
+      Object.keys(L).forEach((uid) => {
