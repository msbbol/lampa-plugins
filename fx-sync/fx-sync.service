[Unit]
Description=fx-sync: watched titles from Lampa to Filmix playlists
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/fx-sync/fx-sync.py
Environment=PORT=9122
DynamicUser=yes
StateDirectory=fx-sync
StateDirectoryMode=0700
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
